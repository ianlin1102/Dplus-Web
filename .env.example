# Web 应用环境变量配置模板
# 复制此文件为 .env 并填入实际值

# CloudBase 配置（必需）
# 在腾讯云开发控制台获取
VITE_CLOUDBASE_ENV_ID=cloud1-6gnd02he13c1ff2e
VITE_CLOUDBASE_REGION=ap-shanghai
# Access Key 在腾讯云开发控制台 -> 环境设置 -> 安全配置 -> 访问密钥 中创建
VITE_CLOUDBASE_ACCESS_KEY=your-access-key-here

# API Key（用于云函数验证）
# 在云控制台的云函数环境变量 VALID_API_KEYS 中配置相同的值
VITE_API_KEY=your-api-key-here

# 云函数 HTTP 访问地址
# 在云控制台为 cloud 函数创建 HTTP 触发器后获得
VITE_CLOUD_FUNCTION_URL=https://cloud1-6gnd02he13c1ff2e-xxxxx.service.tcloudbase.com/cloud
